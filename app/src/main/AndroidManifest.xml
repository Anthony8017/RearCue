<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 调试页要按包名解析 Allowlist App 的图标：Android 11+ 需要显式可见性（不用 QUERY_ALL_PACKAGES）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".RearCueApp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RearCue">

        <!-- 背屏准入（票 #4 / E2）：声明参与 miui 背屏策略，进系统背屏白名单，免 hook。 -->
        <meta-data
            android:name="miui.rear.policy"
            android:value="1" />

        <!-- 主屏调试页：Icon Set 实时可视 + 测试通知入口（票 #3） -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku client provider: the Shizuku server hands its binder back to this app through it
             (without it pingBinder() stays false). The permission must be one the shell uid holds:
             android.permission.INTERACT_ACROSS_USERS_FULL per the Shizuku docs. Declaring
             moe.shizuku.manager.permission.API_V23 (dangerous, shell does not hold it) makes the
             server's callback fail with "Permission Denial ... uid=2000 requires ...API_V23"
             (ticket #8). ASCII-only comment on purpose: the manifest merger mis-decodes non-ASCII. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 通知监听：需在系统「通知使用权」中授权（adb: cmd notification allow_listener） -->
        <service
            android:name=".notify.RearNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
