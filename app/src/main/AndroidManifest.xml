<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Overlay channel admission (ticket #10 / E9, spec 0002): TYPE_APPLICATION_OVERLAY needs it.
         Granted via appops (tools/ex 01-install): without this declaration the grant is silently
         ineffective and Settings.canDrawOverlays() stays false. ASCII-only on purpose: the
         manifest merger corrupts non-ASCII comments (ticket #4). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 调试页要按包名解析 Allowlist App 的图标：Android 11+ 需要显式可见性（不用 QUERY_ALL_PACKAGES）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Seed allowlist entry without a launcher activity (spec 0005): the launcher
             intent query above does not cover it, so name it explicitly. -->
        <package android:name="com.android.shell" />
    </queries>

    <application
        android:name=".RearCueApp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RearCue">

        <!-- 背屏准入（票 #4 / E2）：声明参与 miui 背屏策略，进系统背屏白名单，免 hook。 -->
        <meta-data
            android:name="miui.rear.policy"
            android:value="1" />

        <!-- 主屏调试页：Icon Set 实时可视 + 测试通知入口（票 #3） -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Allowlist settings page (spec 0005): manage allowlist apps. -->
        <activity
            android:name=".ui.AllowlistSettingsActivity"
            android:exported="false" />

        <!-- Shizuku client provider: the Shizuku server hands its binder back to this app through it
             (without it pingBinder() stays false). The permission must be one the shell uid holds:
             android.permission.INTERACT_ACROSS_USERS_FULL per the Shizuku docs. Declaring
             moe.shizuku.manager.permission.API_V23 (dangerous, shell does not hold it) makes the
             server's callback fail with "Permission Denial ... uid=2000 requires ...API_V23"
             (ticket #8). ASCII-only comment on purpose: the manifest merger mis-decodes non-ASCII. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 通知监听：需在系统「通知使用权」中授权（adb: cmd notification allow_listener） -->
        <service
            android:name=".notify.RearNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Quick Tile Entry (spec 0006 / ticket #54): the official manual cast/exit entry in
             the control center. State mirrors Presence; click toggles through the core's
             ManualCast/ManualExit (manual source: exempt from DND Follow and Posture Gate). -->
        <service
            android:name=".tile.RearCueTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_rear_indicator"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
