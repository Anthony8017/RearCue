<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Agent Mirror relay connection (spec 0010 / ticket #80): the app's first network
         permission. Guarded by NetworkManifestTest so it cannot silently regress. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Overlay channel admission (ticket #10 / E9, spec 0002): TYPE_APPLICATION_OVERLAY needs it.
         Granted via appops (tools/ex 01-install): without this declaration the grant is silently
         ineffective and Settings.canDrawOverlays() stays false. ASCII-only on purpose: the
         manifest merger corrupts non-ASCII comments (ticket #4). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 调试页要按包名解析 Icon Set 中应用的图标：Android 11+ 需要显式可见性（不用 QUERY_ALL_PACKAGES）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- A package that reaches the Icon Set without a launcher activity (shell posts the
             automation's notifications): the launcher intent query above does not cover it,
             so name it explicitly. -->
        <package android:name="com.android.shell" />
    </queries>

    <application
        android:name=".RearCueApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RearCue">

        <!-- 背屏准入（票 #4 / E2）：声明参与 miui 背屏策略，进系统背屏白名单，免 hook。 -->
        <meta-data
            android:name="miui.rear.policy"
            android:value="1" />

        <!-- 主屏调试页：Icon Set 实时可视 + 测试通知入口（票 #3） -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings page: allowlist, charging animation, and posture gate. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AllowlistSettingsActivity"
            android:exported="false" />

        <!-- 冻结唤醒空转页（Freeze Thaw Nudge）：设备侧保活循环在被冻时 am start 它，
             系统为启动 Activity 必须先解冻进程，压住的通知事件随之补投。无 UI、立即 finish、
             独立 taskAffinity（不打扰背屏 Dashboard 所在任务）；exported 是 adb/shell uid
             启动的硬要求。 -->
        <activity
            android:name=".ThawNudgeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity="" />

        <!-- Shizuku client provider: the Shizuku server hands its binder back to this app through it
             (without it pingBinder() stays false). The permission must be one the shell uid holds:
             android.permission.INTERACT_ACROSS_USERS_FULL per the Shizuku docs. Declaring
             moe.shizuku.manager.permission.API_V23 (dangerous, shell does not hold it) makes the
             server's callback fail with "Permission Denial ... uid=2000 requires ...API_V23"
             (ticket #8). ASCII-only comment on purpose: the manifest merger mis-decodes non-ASCII. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 通知监听：需在系统「通知使用权」中授权（adb: cmd notification allow_listener） -->
        <service
            android:name=".notify.RearNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Quick Tile Entry (spec 0006 / ticket #54): the official manual cast/exit entry in
             the control center. State mirrors Presence; click toggles through the core's
             ManualCast/ManualExit (manual source: exempt from Posture Gate). -->
        <service
            android:name=".tile.RearCueTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_rear_indicator"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Remote Approval action sink (spec 0018-4 / ticket #174): approve/reject/select buttons
             on Agent Alert notifications land here and share the single session-action chain.
             Not exported: only this app's own notification PendingIntents may reach it. -->
        <receiver
            android:name=".notify.AgentActionReceiver"
            android:exported="false" />
    </application>

</manifest>
