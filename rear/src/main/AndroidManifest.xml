<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Shizuku UserService (ticket #4, ADR-0001 Route A): Shizuku starts this class with the
      shell uid, and it runs the projection commands on behalf of the app process.
      It is deliberately NOT declared as a <service>: Shizuku instantiates the class itself with
      app_process (it must be an IBinder, see RearShellService), so a service entry would only
      advertise a component that is not an Android Service (ticket #8).
      ASCII-only comments on purpose: the manifest merger mis-decodes non-ASCII here.
    -->
    <application>
        <!-- Rear Dashboard rendered on the rear display (ticket #4). showWhenLocked is also set
             at runtime; the manifest value is what the system sees at launch time (ticket #6 E3:
             a locked main screen must not take the Dashboard down).
             turnScreenOn must NOT be declared here (issue #43): the locked-first-cast fallback
             creates this activity on Display 0 first (am start with a display option is denied
             while locked, E3/E14), and the manifest flag made the system wake Main Display
             at launch (PowerGroup group 0, TURN_ON:handleTurnScreenOn), which violates spec #36
             story 8/12.
             The runtime call in onCreate only turns the screen on when the activity really lands
             on the rear display; rear visibility while projecting is guaranteed by Wake
             Keep-alive (ADR 0003, injection loop started before launch).
             exported + DUMP: the Shizuku fallback starts this activity from the shell uid
             (am start with a display option), and shell is the only non-system uid holding
             DUMP (signature|privileged|development). Without it the fallback dies on
             "not exported from uid 10332" (ticket #6 E8 measurement). -->
        <activity
            android:name=".RearDashboardActivity"
            android:excludeFromRecents="true"
            android:taskAffinity="com.rearcue.poc.rear.dashboard"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:showWhenLocked="true" />
    </application>

</manifest>
