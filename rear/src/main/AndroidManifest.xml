<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Shizuku UserService (ticket #4, ADR-0001 Route A): Shizuku starts this service with the
      shell uid, and it runs the projection commands on behalf of the app process.
      ASCII-only comments on purpose: the manifest merger mis-decodes non-ASCII here.
    -->
    <application>
        <service
            android:name=".RearShellService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:process=":shizuku">
            <intent-filter>
                <action android:name="moe.shizuku.api.BIND_USER_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="moe.shizuku.api.USER_SERVICE_VERSION"
                android:value="1" />
        </service>

        <!-- Rear Dashboard rendered on the rear display (ticket #4). -->
        <activity
            android:name=".RearDashboardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:turnScreenOn="true" />
    </application>

</manifest>
